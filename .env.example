# --- required ---
GEMINI_API_KEY=
# CreateOS sandbox key (from `stripe projects add createos/project` or createos.sh/app)
CREATEOS_SANDBOX_API_KEY=

# --- storage: Postgres for trials, events and sessions (empty = local files in recordings/ and data/) ---
# e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=

# --- GitHub (needed for PR comments + commit statuses; public PRs can be tried without it) ---
# Fine-grained PAT on the demo repo: Contents read, Pull requests read/write, Commit statuses read/write
GITHUB_TOKEN=
# Same secret you paste in the repo's webhook settings
WEBHOOK_SECRET=
# Your ngrok URL (ngrok http 3000), used for "watch live" links in PR comments
PUBLIC_URL=

# --- "Sign in with GitHub" (OAuth App: github.com/settings/developers -> OAuth Apps) ---
# Homepage URL = PUBLIC_URL, Authorization callback URL = PUBLIC_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random 32+ chars; encrypts data/sessions.json (openssl rand -hex 32)
SESSION_SECRET=

# --- optional tuning ---
# POLL_INTERVAL_SEC=60          (auto-trial: how often to check signed-in users' open PRs)
# MAX_AUTO_TRIALS_PER_HOUR=10   (per user)
# MAX_CONCURRENT_TRIALS=2       (2 sandboxes each)
# COUNSEL_MODEL=gemini-3.5-flash-lite
# CLERK_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.8-flash
# COUNSEL_THINKING=low
# LLM_STREAM=1
# SANDBOX_SHAPE=s-1vcpu-1gb
# SANDBOX_EGRESS=pypi.org:443,*.pythonhosted.org:443,registry.npmjs.org:443,...   (empty = allow all; default = PyPI, npm, Go proxy, crates.io)
# ROUNDS=2
# MAX_EXHIBITS=3
