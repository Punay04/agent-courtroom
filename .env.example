# --- required ---
GEMINI_API_KEY=
# CreateOS sandbox key (from `stripe projects add createos/project` or createos.sh/app)
CREATEOS_SANDBOX_API_KEY=

# --- GitHub (needed for PR comments + commit statuses; public PRs can be tried without it) ---
# Fine-grained PAT on the demo repo: Contents read, Pull requests read/write, Commit statuses read/write
GITHUB_TOKEN=
# Same secret you paste in the repo's webhook settings
WEBHOOK_SECRET=
# Your ngrok URL (ngrok http 3000), used for "watch live" links in PR comments
PUBLIC_URL=

# --- optional tuning ---
# COUNSEL_MODEL=gemini-3.8-flash
# CLERK_MODEL=gemini-3.8-flash
# JUDGE_MODEL=gemini-4-argon
# COUNSEL_THINKING=low
# LLM_STREAM=1
# SANDBOX_SHAPE=s-1vcpu-1gb
# SANDBOX_EGRESS=pypi.org:443,*.pythonhosted.org:443   (empty = allow all)
# ROUNDS=2
# MAX_EXHIBITS=3
